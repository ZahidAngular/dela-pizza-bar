# ---------------------------------------------------------------------------
# Google Reviews (optional)
#
# Without these the site shows a curated set of real Google reviews as a
# fallback. Set both and the Reviews section pulls the live rating, review
# count and latest reviews straight from Google, refreshed once a day.
#
# 1. GOOGLE_PLACES_API_KEY
#    console.cloud.google.com → create a project → enable "Places API (New)"
#    → Credentials → Create API key.
#    Restrict it: Application restrictions = None (it is used server-side
#    only), API restrictions = Places API (New).
#
# 2. GOOGLE_PLACE_ID
#    developers.google.com/maps/documentation/places/web-service/place-id
#    Search "Dela Pizza Bar, 331 Prospect Rd, Blair Athol" in the Place ID
#    finder and copy the ID (starts with ChIJ...).
#
# Copy this file to .env.local and fill in the values. .env.local is
# gitignored — never commit real keys.
# ---------------------------------------------------------------------------

GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
